    {
        "id": "1c558975da33f5be",
        "type": "function",
        "z": "26177693d52d5203",
        "name": "Extract Status",
        "func": "// Ensure the payload is an object\nlet data = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n\n// Grab the status string (\"Safe\" or \"Polluted\")\nlet currentStatus = data.status;\n\n// Set the payload to the text we want to display\nmsg.payload = currentStatus;\n\n// Change the text color based on the status\nif (currentStatus === \"Polluted\") {\n    msg.color = \"red\";\n} else {\n    msg.color = \"green\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
