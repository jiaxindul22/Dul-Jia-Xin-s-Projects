        "func": "// Ensure the payload is an object\nlet data = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n\n// Extract the turbidity ADC value\nmsg.payload = data.turbidity;\n\nreturn msg;",
